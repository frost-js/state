{
    "name": "@fr0st/state",
    "version": "1.1.1",
    "description": "Small reactive state primitives for values, effects, and keyed stores.",
    "keywords": [
        "state",
        "reactive",
        "signals",
        "effects",
        "store",
        "state-management",
        "javascript",
        "esm"
    ],
    "homepage": "https://github.com/elusivecodes/FrostState",
    "bugs": {
        "url": "https://github.com/elusivecodes/FrostState/issues",
        "email": "elusivecodes@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/elusivecodes/FrostState.git"
    },
    "license": "MIT",
    "author": "Elusive <elusivecodes@gmail.com>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/frost-state.esm.js",
            "default": "./dist/frost-state.esm.js"
        },
        "./dist/*": "./dist/*",
        "./src/*": "./src/*"
    },
    "main": "./dist/frost-state.esm.js",
    "jsdelivr": "./dist/frost-state.min.js",
    "unpkg": "./dist/frost-state.min.js",
    "module": "./dist/frost-state.esm.js",
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "src"
    ],
    "scripts": {
        "build": "vite build",
        "lint": "eslint",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@fr0st/eslint-config": "^5.0.2",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^10.9.1",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "publishConfig": {
        "access": "public"
    }
}
